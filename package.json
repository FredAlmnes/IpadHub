{
  "name": "ipadhub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ipadhub --local",
    "db:migrate:remote": "wrangler d1 migrations apply ipadhub --remote",
    "pair:approve": "node scripts/approve-pairing.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  }
}

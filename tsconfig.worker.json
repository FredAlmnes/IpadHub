{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "node_modules/.tmp/worker",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": ["src/worker", "src/shared", "test", "worker-configuration.d.ts", "vitest.config.ts"]
}
